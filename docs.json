{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Sidekin",
  "theme": "mint",
  "description": "Calendar building blocks for people, companies, and their agents.",
  "colors": {
    "primary": "#214c3d",
    "light": "#214c3d",
    "dark": "#214c3d"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#f8f7f3",
      "dark": "#f8f7f3"
    }
  },
  "fonts": {
    "heading": {
      "family": "Manrope",
      "source": "/fonts/manrope-bold.woff2",
      "format": "woff2",
      "weight": 700
    },
    "body": {
      "family": "Manrope",
      "source": "/fonts/manrope-regular.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg",
    "href": "https://sidekin.ai"
  },
  "navigation": {
    "groups": [
      {
        "group": "Build with Sidekin",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Public contracts",
        "pages": [
          "calendar",
          "projects",
          "configuration",
          "booking"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Sidekin",
        "href": "https://sidekin.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.sidekin.ai/auth/login"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Sidekin",
        "items": [
          {
            "label": "Privacy & data use",
            "href": "https://sidekin.ai/privacy/"
          },
          {
            "label": "Say hello",
            "href": "mailto:founders@onepatch.dev"
          }
        ]
      }
    ]
  }
}
